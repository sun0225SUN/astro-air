---
import Pager from '../../../../../../components/blog/Pager.astro'
import PostList from '../../../../../../components/blog/PostList.astro'
import { locales, useTranslations } from '../../../../../../i18n'
import Layout from '../../../../../../layouts/Layout.astro'
import {
  getPostsByTag,
  getTags,
  pageLocale,
} from '../../../../../../lib/content'
import {
  pageCount,
  pageItems,
  postsPerPage,
} from '../../../../../../lib/pagination'

export async function getStaticPaths() {
  if (postsPerPage() === 'all') return []
  const paths = []
  for (const lang of locales) {
    const tags = await getTags(lang)
    for (const tag of tags) {
      const posts = await getPostsByTag(lang, tag.slug)
      const lastPage = pageCount(posts.length)
      for (let page = 2; page <= lastPage; page++) {
        paths.push({
          params: { lang, slug: tag.slug, page: String(page) },
          props: { tag },
        })
      }
    }
  }
  return paths
}

interface Props {
  tag: { name: string }
}

const lang = pageLocale(Astro.currentLocale, Astro.params.lang)
const page = Number(Astro.params.page)
const { tag } = Astro.props
const t = useTranslations(lang)
const posts = await getPostsByTag(lang, Astro.params.slug ?? '')
---

<Layout
  title={tag.name}
  description={t('blog.tagDescription', { name: tag.name })}
>
  <h1 class="mt-2 mb-9 text-2xl font-semibold">#{tag.name}</h1>
  <PostList posts={pageItems(posts, page)} variant="dated" />
  <Pager
    page={page}
    lastPage={pageCount(posts.length)}
    base={`blog/tag/${Astro.params.slug}`}
  />
</Layout>
