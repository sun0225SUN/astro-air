---
import { getRelativeLocaleUrl } from 'astro:i18n'
import { localePaths, useTranslations } from '../../../../i18n'
import Layout from '../../../../layouts/Layout.astro'
import { getTags, pageLocale } from '../../../../lib/content'

export function getStaticPaths() {
  return localePaths()
}

const lang = pageLocale(Astro.currentLocale, Astro.params.lang)
const t = useTranslations(lang)
const tags = await getTags(lang)
---

<Layout title={t('blog.tags')} description={t('blog.tagsDescription')}>
  <h1 class="mt-2 mb-9 text-2xl font-semibold">{t('blog.tags')}</h1>
  <div class="flex flex-wrap gap-x-4 gap-y-2 text-sm text-gray-500">
    {tags.map((tag) => (
      <a
        href={getRelativeLocaleUrl(lang, `blog/tag/${tag.slug}`)}
        class='hover:scale-105'
      >
        #{tag.name}
      </a>
    ))}
  </div>
</Layout>
