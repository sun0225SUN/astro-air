---
import { getRelativeLocaleUrl } from 'astro:i18n'
import { locales, useTranslations } from '../../../../i18n'
import Layout from '../../../../layouts/Layout.astro'
import { getTags, localeFromParam } from '../../../../lib/content'

export function getStaticPaths() {
  return locales.map((lang) => ({ params: { lang } }))
}

const lang = localeFromParam(Astro.currentLocale ?? Astro.params.lang)
const t = useTranslations(lang)
const tags = await getTags(lang)
---

<Layout title={t('blog.tags')} description={t('blog.tagsDescription')}>
  <h1
    id="content"
    class="mb-2 text-3xl leading-tight font-semibold"
    tabindex="-1"
  >
    {t('blog.tags')}
  </h1>
  {tags.length === 0 ? (
    <p>{t('home.empty')}</p>
  ) : (
    <ul
      class='m-0 flex list-none flex-wrap items-baseline gap-x-3 gap-y-2 p-0'
      role='list'
    >
      {tags.map((tag) => (
        <li class='flex items-baseline gap-2'>
          <a
            class='no-underline'
            href={getRelativeLocaleUrl(lang, `blog/tag/${tag.slug}`)}
          >
            {tag.name}
          </a>
          <span class='text-muted'>
            {t('blog.count').replace('{count}', String(tag.count))}
          </span>
        </li>
      ))}
    </ul>
  )}
</Layout>
