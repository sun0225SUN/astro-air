---
import { getRelativeLocaleUrl } from 'astro:i18n'
import { localePaths, useTranslations } from '../../../../i18n'
import Layout from '../../../../layouts/Layout.astro'
import { getTags, pageLocale } from '../../../../lib/content'

export function getStaticPaths() {
  return localePaths()
}

const lang = pageLocale(Astro.currentLocale, Astro.params.lang)
const t = useTranslations(lang)
const tags = await getTags(lang)
---

<Layout title={t('nav.tags')} description={t('blog.tagsDescription')}>
  <h1 class="mb-8 text-2xl font-semibold">{t('nav.tags')}</h1>
  {tags.length === 0 ? (
    <p class='text-muted dark:text-muted-dark'>{t('home.empty')}</p>
  ) : (
    <ul class='flex flex-wrap gap-3'>
      {tags.map((tag) => (
        <li>
          <a
            href={getRelativeLocaleUrl(lang, `blog/tag/${tag.slug}`)}
            class='inline-flex items-baseline gap-2 rounded-full border border-line px-3 py-1 text-sm hover:border-accent hover:text-accent dark:border-line-dark dark:hover:border-accent-dark dark:hover:text-accent-dark'
          >
            {tag.name}
            <span class='text-xs text-faint'>{tag.count}</span>
          </a>
        </li>
      ))}
    </ul>
  )}
</Layout>
