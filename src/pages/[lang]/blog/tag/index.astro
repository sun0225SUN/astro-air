---
import { getRelativeLocaleUrl } from 'astro:i18n'
import PageShell from '../../../../components/content/PageShell.astro'
import { localePaths, useTranslations } from '../../../../i18n'
import { getTags, pageLocale } from '../../../../lib/content'

export function getStaticPaths() {
  return localePaths()
}

const lang = pageLocale(Astro.currentLocale, Astro.params.lang)
const t = useTranslations(lang)
const tags = await getTags(lang)
---

<PageShell title={t('blog.tags')} description={t('blog.tagsDescription')}>
  {tags.length === 0 ? (
    <p>{t('home.empty')}</p>
  ) : (
    <ul
      class='m-0 flex list-none flex-wrap items-baseline gap-x-3 gap-y-2 p-0'
      role='list'
    >
      {tags.map((tag) => (
        <li class='flex items-baseline gap-2'>
          <a
            class='no-underline'
            href={getRelativeLocaleUrl(lang, `blog/tag/${tag.slug}`)}
          >
            {tag.name}
          </a>
          <span class='text-muted'>
            {t('blog.count', { count: tag.count })}
          </span>
        </li>
      ))}
    </ul>
  )}
</PageShell>
