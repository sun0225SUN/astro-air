---
import { getRelativeLocaleUrl } from 'astro:i18n'
import { PostList } from '../../../components'
import { locales, useTranslations } from '../../../i18n/ui'
import Layout from '../../../layouts/Layout.astro'
import { localeFromParam } from '../../../lib/content'

export function getStaticPaths() {
  return locales.map((lang) => ({ params: { lang } }))
}

const lang = localeFromParam(Astro.currentLocale ?? Astro.params.lang)
const t = useTranslations(lang)
---

<Layout title={t('nav.blog')} description={t('blog.description')}>
  <h1 id="content" tabindex="-1">{t('nav.blog')}</h1>
  <p class="meta">
    <a href={getRelativeLocaleUrl(lang, 'blog/category')}
      >{t('blog.categories')}</a
    >
    {' · '}
    <a href={getRelativeLocaleUrl(lang, 'blog/tag')}>{t('blog.tags')}</a>
  </p>
  <PostList />
</Layout>
