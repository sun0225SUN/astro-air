---
import PostList from '../../../components/blog/PostList.astro'
import { localePaths, useTranslations } from '../../../i18n'
import Layout from '../../../layouts/Layout.astro'
import { pageLocale } from '../../../lib/content'

export function getStaticPaths() {
  return localePaths()
}

const lang = pageLocale(Astro.currentLocale, Astro.params.lang)
const t = useTranslations(lang)
---

<Layout title={t('nav.blog')} description={t('blog.description')}>
  <PostList variant="archive" />
</Layout>
