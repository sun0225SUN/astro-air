---
import PostList from '../../../components/PostList.astro'
import { locales, useTranslations } from '../../../i18n/ui'
import Layout from '../../../layouts/Layout.astro'
import { getBlogPosts, localeFromParam } from '../../../lib/content'

export function getStaticPaths() {
  return locales.map((lang) => ({ params: { lang } }))
}

const lang = localeFromParam(Astro.currentLocale ?? Astro.params.lang)
const t = useTranslations(lang)
const posts = await getBlogPosts(lang)
---

<Layout title={t('nav.blog')} description={t('blog.description')}>
  <h1 id="content" tabindex="-1">{t('nav.blog')}</h1>
  <PostList posts={posts} />
</Layout>
