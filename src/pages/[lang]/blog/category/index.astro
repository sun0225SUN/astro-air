---
import { getRelativeLocaleUrl } from 'astro:i18n'
import { locales, useTranslations } from '../../../../i18n'
import Layout from '../../../../layouts/Layout.astro'
import { getCategories, localeFromParam } from '../../../../lib/content'

export function getStaticPaths() {
  return locales.map((lang) => ({ params: { lang } }))
}

const lang = localeFromParam(Astro.currentLocale ?? Astro.params.lang)
const t = useTranslations(lang)
const categories = await getCategories(lang)
---

<Layout
  title={t('blog.categories')}
  description={t('blog.categoriesDescription')}
>
  <h1
    id="content"
    class="mb-2 text-3xl leading-tight font-semibold"
    tabindex="-1"
  >
    {t('blog.categories')}
  </h1>
  {categories.length === 0 ? (
    <p>{t('home.empty')}</p>
  ) : (
    <ul class='m-0 list-none p-0' role='list'>
      {categories.map((category) => (
        <li class='border-b border-line py-4'>
          <a
            class='text-xl no-underline'
            href={getRelativeLocaleUrl(lang, `blog/category/${category.slug}`)}
          >
            {category.name}
          </a>
          <p class='text-muted'>
            {t('blog.count').replace('{count}', String(category.count))}
          </p>
        </li>
      ))}
    </ul>
  )}
</Layout>
