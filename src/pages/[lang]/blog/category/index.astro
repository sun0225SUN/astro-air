---
import { getRelativeLocaleUrl } from 'astro:i18n'
import PageShell from '../../../../components/content/PageShell.astro'
import { localePaths, useTranslations } from '../../../../i18n'
import { getCategories, pageLocale } from '../../../../lib/content'

export function getStaticPaths() {
  return localePaths()
}

const lang = pageLocale(Astro.currentLocale, Astro.params.lang)
const t = useTranslations(lang)
const categories = await getCategories(lang)
---

<PageShell
  title={t('blog.categories')}
  description={t('blog.categoriesDescription')}
>
  {categories.length === 0 ? (
    <p>{t('home.empty')}</p>
  ) : (
    <ul class='m-0 list-none p-0' role='list'>
      {categories.map((category) => (
        <li class='border-b border-line py-4'>
          <a
            class='text-xl no-underline'
            href={getRelativeLocaleUrl(lang, `blog/category/${category.slug}`)}
          >
            {category.name}
          </a>
          <p class='text-muted'>{t('blog.count', { count: category.count })}</p>
        </li>
      ))}
    </ul>
  )}
</PageShell>
