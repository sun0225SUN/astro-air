---
import { getRelativeLocaleUrl } from 'astro:i18n'
import PostList from '../../../../components/blog/PostList.astro'
import PageShell from '../../../../components/content/PageShell.astro'
import { locales, useTranslations } from '../../../../i18n'
import {
  getCategories,
  getPostsByCategory,
  pageLocale,
} from '../../../../lib/content'

export async function getStaticPaths() {
  const paths = []
  for (const lang of locales) {
    const categories = await getCategories(lang)
    for (const category of categories) {
      paths.push({
        params: { lang, slug: category.slug },
        props: { category },
      })
    }
  }
  return paths
}

interface Props {
  category: { name: string }
}

const lang = pageLocale(Astro.currentLocale, Astro.params.lang)
const { category } = Astro.props
const t = useTranslations(lang)
const posts = await getPostsByCategory(lang, Astro.params.slug ?? '')
---

<PageShell
  title={category.name}
  description={t('blog.categoryDescription', { name: category.name })}
>
  <p class="text-muted">
    <a href={getRelativeLocaleUrl(lang, 'blog/category')}
      >{t('blog.categories')}</a
    >
  </p>
  <PostList posts={posts} />
</PageShell>
