---
import { getRelativeLocaleUrl } from 'astro:i18n'
import PostList from '../../components/blog/PostList.astro'
import PageList from '../../components/content/PageList.astro'
import { config } from '../../config'
import { locales, useTranslations } from '../../i18n'
import Layout from '../../layouts/Layout.astro'
import { localeFromParam } from '../../lib/content'

export function getStaticPaths() {
  return locales.map((lang) => ({ params: { lang } }))
}

const lang = localeFromParam(Astro.currentLocale ?? Astro.params.lang)
const t = useTranslations(lang)
---

<Layout title={config.title} description={t('site.description')}>
  <h1
    id="content"
    class="mb-2 text-3xl leading-tight font-semibold"
    tabindex="-1"
  >
    {config.title}
  </h1>
  <p class="text-muted">{t('site.description')}</p>

  <section aria-labelledby="posts-heading">
    <h2 id="posts-heading" class="text-2xl leading-snug font-semibold">
      {t('home.posts')}
    </h2>
    <PostList />
    <p><a href={getRelativeLocaleUrl(lang, 'blog')}>{t('home.allPosts')}</a></p>
  </section>

  <section aria-labelledby="pages-heading">
    <h2 id="pages-heading" class="text-2xl leading-snug font-semibold">
      {t('home.pages')}
    </h2>
    <PageList />
  </section>
</Layout>
