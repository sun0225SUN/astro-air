---
import { getRelativeLocaleUrl } from 'astro:i18n'
import PostList from '../../components/blog/PostList.astro'
import PageList from '../../components/content/PageList.astro'
import PageShell from '../../components/content/PageShell.astro'
import { config } from '../../config'
import { localePaths, useTranslations } from '../../i18n'
import { pageLocale } from '../../lib/content'

export function getStaticPaths() {
  return localePaths()
}

const lang = pageLocale(Astro.currentLocale, Astro.params.lang)
const t = useTranslations(lang)
---

<PageShell title={config.title} description={t('site.description')}>
  <p class="text-muted">{t('site.description')}</p>

  <section aria-labelledby="posts-heading">
    <h2 id="posts-heading" class="text-2xl leading-snug font-semibold">
      {t('home.posts')}
    </h2>
    <PostList />
    <p><a href={getRelativeLocaleUrl(lang, 'blog')}>{t('home.allPosts')}</a></p>
  </section>

  <section aria-labelledby="pages-heading">
    <h2 id="pages-heading" class="text-2xl leading-snug font-semibold">
      {t('home.pages')}
    </h2>
    <PageList />
  </section>
</PageShell>
