---
import Pager from '../../../../components/blog/Pager.astro'
import PostList from '../../../../components/blog/PostList.astro'
import { locales, useTranslations } from '../../../../i18n'
import Layout from '../../../../layouts/Layout.astro'
import { getPostsByTag, getTags, pageLocale } from '../../../../lib/content'
import { pageCount, pageItems } from '../../../../lib/pagination'

export async function getStaticPaths() {
  const paths = []
  for (const lang of locales) {
    const tags = await getTags(lang)
    for (const tag of tags) {
      paths.push({ params: { lang, slug: tag.slug }, props: { tag } })
    }
  }
  return paths
}

interface Props {
  tag: { name: string }
}

const lang = pageLocale(Astro.currentLocale, Astro.params.lang)
const { tag } = Astro.props
const t = useTranslations(lang)
const posts = await getPostsByTag(lang, Astro.params.slug ?? '')
---

<Layout
  title={tag.name}
  description={t('blog.tagDescription', { name: tag.name })}
>
  <h1 class="mb-8 text-2xl font-semibold">#{tag.name}</h1>
  <PostList posts={pageItems(posts, 1)} variant="dated" />
  <Pager
    page={1}
    lastPage={pageCount(posts.length)}
    base={`posts/tag/${Astro.params.slug}`}
  />
</Layout>
