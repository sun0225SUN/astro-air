---
import { getRelativeLocaleUrl } from 'astro:i18n'
import PageShell from '../components/content/PageShell.astro'
import { defaultLang, useTranslations } from '../i18n'

const t = useTranslations(defaultLang)
---

<PageShell title={t('notFound.title')} description={t('notFound.body')}>
  <p>{t('notFound.body')}</p>
  <p><a href={getRelativeLocaleUrl(defaultLang)}>{t('notFound.home')}</a></p>
</PageShell>
