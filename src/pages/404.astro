---
import { getRelativeLocaleUrl } from 'astro:i18n'
import { defaultLang, useTranslations } from '../i18n'
import Layout from '../layouts/Layout.astro'

const t = useTranslations(defaultLang)
---

<Layout title={t('notFound.title')} description={t('notFound.body')}>
  <h1 id="content" tabindex="-1">{t('notFound.title')}</h1>
  <p>{t('notFound.body')}</p>
  <p><a href={getRelativeLocaleUrl(defaultLang)}>{t('notFound.home')}</a></p>
</Layout>
