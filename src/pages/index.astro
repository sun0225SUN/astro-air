---
import PostList from '../components/PostList.astro'
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts'
import Layout from '../layouts/Layout.astro'
import { getBlogPosts, getCustomPages } from '../lib/content'

const posts = await getBlogPosts()
const pages = await getCustomPages()
---

<Layout title={SITE_TITLE} description={SITE_DESCRIPTION}>
  <h1 id="content" tabindex="-1">{SITE_TITLE}</h1>
  <p class="lede">{SITE_DESCRIPTION}</p>

  <section aria-labelledby="posts-heading">
    <h2 id="posts-heading">Posts</h2>
    <PostList posts={posts} />
    <p><a href="/blog">All posts</a></p>
  </section>

  <section aria-labelledby="pages-heading">
    <h2 id="pages-heading">Pages</h2>
    <ul class="page-list" role="list">
      {pages.map((page) => (
        <li>
          <a href={`/${page.id}`}>{page.data.title}</a>
          <p>{page.data.description}</p>
        </li>
      ))}
    </ul>
  </section>
</Layout>
