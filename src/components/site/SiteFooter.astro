---
import Rss from '@lucide/astro/icons/rss'
import { useTranslations } from '../../i18n'
import { localeFromParam } from '../../lib/content'

const year = new Date().getFullYear()
const t = useTranslations(localeFromParam(Astro.currentLocale))
const [authorBefore, authorAfter] = t('footer.designedBy').split('{author}')
const [themeBefore, themeAfter] = t('footer.poweredBy').split('{theme}')
const [rssBefore, rssAfter] = t('footer.rss').split('{rss}')
---

<footer
  class="mt-8 flex flex-wrap items-center justify-between gap-x-6 gap-y-3 pb-8 text-sm text-muted dark:text-muted-dark"
>
  <p class="flex flex-wrap items-center gap-x-2">
    <span>&copy; {year}</span>
    <span aria-hidden="true">·</span>
    <span class="inline-flex items-center gap-1">
      {authorBefore}
      <a
        href="https://sunguoqi.com"
        class="text-accent hover:text-accent-hover dark:text-accent-dark dark:hover:text-accent-dark-hover"
        data-umami-event="footer"
        data-umami-event-name="author"
        >Guoqi Sun</a
      >
      {authorAfter}
    </span>
    <span aria-hidden="true">·</span>
    <span class="inline-flex items-center gap-1">
      {themeBefore}
      <a
        href="https://github.com/sun0225SUN/astro-air"
        class="text-accent hover:text-accent-hover dark:text-accent-dark dark:hover:text-accent-dark-hover"
        data-umami-event="footer"
        data-umami-event-name="theme"
        >Astro Air</a
      >
      {themeAfter}
    </span>
  </p>
  <p class="inline-flex items-center gap-1.5">
    {rssBefore}
    <a
      href="/rss.xml"
      class="inline-flex items-center gap-1 text-accent hover:text-accent-hover dark:text-accent-dark dark:hover:text-accent-dark-hover"
      data-umami-event="footer"
      data-umami-event-name="rss"
    >
      <Rss size={16} aria-hidden="true" />
      <span>RSS</span>
    </a>
    {rssAfter}
  </p>
</footer>
