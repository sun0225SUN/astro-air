---
import Rss from '@lucide/astro/icons/rss'
import { useTranslations } from '../../i18n'
import { localeFromParam } from '../../lib/content'

const year = new Date().getFullYear()
const t = useTranslations(localeFromParam(Astro.currentLocale))
const [rssBefore, rssAfter] = t('footer.rss').split('{rss}')
---

<footer
  class="text-muted dark:text-muted-dark mt-10 flex flex-wrap items-center justify-between gap-x-6 gap-y-3 py-8 text-sm"
>
  <p class="flex flex-wrap items-center gap-x-2">
    <span>&copy; {year}</span>
    <span aria-hidden="true">·</span>
    <span class="inline-flex items-center gap-1">
      Designed By
      <a
        href="https://sunguoqi.com"
        class="text-accent hover:text-accent-hover dark:text-accent-dark dark:hover:text-accent-dark-hover"
        data-umami-event="footer"
        data-umami-event-name="author"
        >Guoqi Sun</a
      >
    </span>
    <span aria-hidden="true">·</span>
    <span class="inline-flex items-center gap-1">
      Powered By
      <a
        href="https://github.com/sun0225SUN/astro-air"
        class="text-accent hover:text-accent-hover dark:text-accent-dark dark:hover:text-accent-dark-hover"
        data-umami-event="footer"
        data-umami-event-name="theme"
        >Astro Air</a
      >
    </span>
  </p>
  <p class="inline-flex items-center gap-1.5">
    {rssBefore}
    <a
      href="/rss.xml"
      class="text-accent hover:text-accent-hover dark:text-accent-dark dark:hover:text-accent-dark-hover inline-flex items-center gap-1"
      data-umami-event="footer"
      data-umami-event-name="rss"
    >
      <Rss size={16} aria-hidden="true" />
      <span>RSS</span>
    </a>
    {rssAfter}
  </p>
</footer>
