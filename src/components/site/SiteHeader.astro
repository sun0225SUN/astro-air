---
import { getRelativeLocaleUrl } from 'astro:i18n'
import { config } from '../../config'
import { useTranslations } from '../../i18n'
import { localeFromParam } from '../../lib/content'
import LanguageNav from './LanguageNav.astro'
import ThemeToggle from './ThemeToggle.astro'

const lang = localeFromParam(Astro.currentLocale)
const t = useTranslations(lang)
---

<a
  class="sr-only focus:not-sr-only focus:fixed focus:top-3 focus:left-3 focus:z-10 focus:bg-page focus:px-2 focus:py-1 dark:focus:bg-page-dark"
  href="#content"
  >{t('skip')}</a
>
<header class="flex w-full items-center justify-between pt-8">
  <a
    href={getRelativeLocaleUrl(lang)}
    aria-label={config.title}
    class="inline-flex items-center"
  >
    <span class="font-title text-3xl leading-none" transition:name="site-title">
      {config.title}
    </span>
  </a>
  <div class="flex items-center gap-6">
    <LanguageNav />
    <ThemeToggle />
  </div>
</header>
