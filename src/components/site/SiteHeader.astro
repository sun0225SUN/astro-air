---
import { getRelativeLocaleUrl } from 'astro:i18n'
import { config } from '../../config'
import { useTranslations } from '../../i18n'
import { localeFromParam } from '../../lib/content'
import LanguageNav from './LanguageNav.astro'
import ThemeToggle from './ThemeToggle.astro'

const lang = localeFromParam(Astro.currentLocale)
const t = useTranslations(lang)
---

<a
  class="sr-only focus:not-sr-only focus:fixed focus:top-3 focus:left-3 focus:z-10 focus:bg-white focus:px-2 focus:py-1 dark:focus:bg-[#121212]"
  href="#content"
  >{t('skip')}</a
>
<header class="flex h-24 w-full items-center justify-between">
  <a
    href={getRelativeLocaleUrl(lang)}
    aria-label={config.title}
    class="inline-flex h-12 items-center"
  >
    <span
      class="font-title text-3xl leading-none"
      transition:name={`site-title-${lang}`}
      data-disable-theme-toggle-transition
    >
      {config.title}
    </span>
  </a>
  <div class="flex items-center gap-6">
    <LanguageNav />
    <ThemeToggle />
  </div>
</header>
