---
import { getRelativeLocaleUrl } from 'astro:i18n'
import { config } from '../../config'
import { useTranslations } from '../../i18n'
import { localeFromParam } from '../../lib/content'
import LanguageNav from './LanguageNav.astro'
import PrimaryNav from './PrimaryNav.astro'
import ThemeToggle from './ThemeToggle.astro'

const lang = localeFromParam(Astro.currentLocale)
const t = useTranslations(lang)
---

<a class="skip-link visually-hidden" href="#content">{t('skip')}</a>
<header class="site-header">
  <a class="brand" href={getRelativeLocaleUrl(lang)}>{config.title}</a>
  <PrimaryNav />
  <LanguageNav />
  <ThemeToggle />
</header>
