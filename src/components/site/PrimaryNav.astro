---
import { getRelativeLocaleUrl } from 'astro:i18n'
import { useTranslations } from '../../i18n'
import { contentPath, localeFromParam } from '../../lib/content'
import { navLinks } from '../../lib/nav'

const lang = localeFromParam(Astro.currentLocale)
const t = useTranslations(lang)
const current =
  getRelativeLocaleUrl(lang, contentPath(Astro.url.pathname, lang)).replace(
    /\/$/,
    '',
  ) || '/'
const links = await navLinks(lang)

function currentPage(href: string) {
  const normalized = href.replace(/\/$/, '') || '/'
  return normalized === current ? 'page' : undefined
}
---

<nav
  aria-label={t('nav.primary')}
  class="my-8 flex items-center gap-4 text-lg whitespace-nowrap"
>
  {links.map((link) => (
    <a
      href={link.href}
      class='underline-offset-4 hover:underline aria-[current=page]:underline'
      aria-current={currentPage(link.href)}
      data-umami-event='nav'
      data-umami-event-name={link.name}
      target={'external' in link && link.external ? '_blank' : undefined}
      rel={
        'external' in link && link.external ? 'noopener noreferrer' : undefined
      }
    >
      {link.label}
    </a>
  ))}
</nav>
