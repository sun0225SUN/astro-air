---
import Moon from '@lucide/astro/icons/moon'
import Sun from '@lucide/astro/icons/sun'
---

<button
  type="button"
  id="theme-toggle"
  class="cursor-pointer"
  aria-label="Toggle theme"
  title="Toggle theme"
>
  <Sun class="dark:hidden" size={22} aria-hidden="true" />
  <Moon class="hidden dark:block" size={22} aria-hidden="true" />
</button>
<script is:inline>
  const themeButton = document.getElementById('theme-toggle')
  const themeMedia = matchMedia('(prefers-color-scheme: dark)')

  function storeTheme(theme) {
    try {
      localStorage.setItem('theme', theme)
    } catch {
      // The chosen theme still applies for this page.
    }
  }

  function applyTheme(theme) {
    document.documentElement.classList.toggle('dark', theme === 'dark')
    storeTheme(theme)
  }

  if (themeButton && themeButton.dataset.bound !== 'true') {
    themeButton.dataset.bound = 'true'
    themeButton.addEventListener('click', () => {
      const next = document.documentElement.classList.contains('dark')
        ? 'light'
        : 'dark'
      const reduceMotion = matchMedia(
        '(prefers-reduced-motion: reduce)',
      ).matches
      if (reduceMotion || !document.startViewTransition) {
        applyTheme(next)
        return
      }

      const root = document.documentElement
      root.style.setProperty('view-transition-name', 'theme-toggle-transition')
      root.setAttribute('data-theme-changing', '')
      const transition = document.startViewTransition(() => applyTheme(next))
      transition.finished.then(() => {
        root.style.removeProperty('view-transition-name')
        root.removeAttribute('data-theme-changing')
      })
    })
  }

  if (!window.__themeStorageBound) {
    window.__themeStorageBound = true
    window.addEventListener('storage', (event) => {
      if (event.key !== 'theme') return
      const theme =
        event.newValue === 'dark' || event.newValue === 'light'
          ? event.newValue
          : themeMedia.matches
            ? 'dark'
            : 'light'
      document.documentElement.classList.toggle('dark', theme === 'dark')
    })
  }
</script>
