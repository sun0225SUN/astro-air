---
import Moon from '@lucide/astro/icons/moon'
import Sun from '@lucide/astro/icons/sun'
---

<button
  type="button"
  id="theme-toggle"
  class="cursor-pointer"
  aria-label="Toggle theme"
  title="Toggle theme"
  data-umami-event="theme-toggle"
>
  <Sun class="dark:hidden" size={22} aria-hidden="true" />
  <Moon class="hidden dark:block" size={22} aria-hidden="true" />
</button>
<script is:inline>
  const themeMedia = matchMedia('(prefers-color-scheme: dark)')

  function storeTheme(theme) {
    try {
      localStorage.setItem('theme', theme)
    } catch {
      // The chosen theme still applies for this page.
    }
  }

  function applyTheme(theme) {
    document.documentElement.classList.toggle('dark', theme === 'dark')
    storeTheme(theme)
  }

  function clearThemeTransition() {
    const root = document.documentElement
    root.style.removeProperty('view-transition-name')
    root.removeAttribute('data-theme-changing')
  }

  if (!window.__themeToggleBound) {
    window.__themeToggleBound = true
    let themeTransition = null
    let generation = 0

    document.addEventListener('click', (event) => {
      const button = event.target.closest('#theme-toggle')
      if (!button) return
      const next = document.documentElement.classList.contains('dark')
        ? 'light'
        : 'dark'
      button.setAttribute('data-umami-event-theme', next)
      const gen = ++generation
      const reduceMotion = matchMedia(
        '(prefers-reduced-motion: reduce)',
      ).matches
      const canAnimate =
        !reduceMotion &&
        !themeTransition &&
        typeof document.startViewTransition === 'function'
      if (!canAnimate) {
        themeTransition?.skipTransition?.()
        themeTransition = null
        clearThemeTransition()
        applyTheme(next)
        return
      }

      const root = document.documentElement
      root.style.setProperty('view-transition-name', 'theme-toggle-transition')
      root.setAttribute('data-theme-changing', '')
      const done = () => {
        if (gen !== generation) return
        themeTransition = null
        clearThemeTransition()
      }
      try {
        themeTransition = document.startViewTransition(() => {
          if (gen !== generation) return
          applyTheme(next)
        })
      } catch {
        themeTransition = null
        clearThemeTransition()
        applyTheme(next)
        return
      }
      themeTransition.finished.then(done, done)
    })

    document.addEventListener('astro:before-preparation', () => {
      generation += 1
      themeTransition?.skipTransition?.()
      themeTransition = null
      clearThemeTransition()
    })

    window.addEventListener('storage', (event) => {
      if (event.key !== 'theme') return
      const theme =
        event.newValue === 'dark' || event.newValue === 'light'
          ? event.newValue
          : themeMedia.matches
            ? 'dark'
            : 'light'
      document.documentElement.classList.toggle('dark', theme === 'dark')
    })
  }
</script>
