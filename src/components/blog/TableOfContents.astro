---
import type { MarkdownHeading } from 'astro'
import { useTranslations } from '../../i18n'
import { localeFromParam } from '../../lib/content'

interface Props {
  headings: MarkdownHeading[]
}

const { headings } = Astro.props
const t = useTranslations(localeFromParam(Astro.currentLocale))
const items = headings.filter(
  (heading) => heading.depth >= 2 && heading.depth <= 3,
)
---

{items.length > 0 && (
  <div class='toc-container' id='toc'>
    <nav class='toc-nav' aria-label={t('post.toc')}>
      <ul class='toc-list'>
        <li class='toc-item toc-level-0'>
          <a
            href='#content'
            class='toc-link toc-title'
            data-text={t('post.backToTop')}
          >
            {t('post.backToTop')}
          </a>
        </li>
        {items.map((heading) => (
          <li class={`toc-item toc-level-${heading.depth - 1}`}>
            <a
              href={`#${heading.slug}`}
              class='toc-link'
              data-text={heading.text}
            >
              {heading.text}
            </a>
          </li>
        ))}
      </ul>
    </nav>
  </div>
)}

<style>
  .toc-container {
    display: none;
  }

  @media (min-width: 1400px) {
    .toc-container {
      position: fixed;
      top: 50%;
      left: calc(50% + 30rem);
      z-index: 20;
      display: block;
      width: 11rem;
      transform: translateY(-50%);
    }
  }

  .toc-list,
  .toc-item {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .toc-link {
    position: relative;
    display: block;
    height: 1.125rem;
    overflow: hidden;
    color: transparent;
    font-size: 0;
    line-height: 1.125rem;
    white-space: nowrap;
    text-decoration: none;
    text-indent: 1.35rem;
    text-overflow: ellipsis;
    cursor: pointer;
  }

  .toc-link::before {
    content: "";
    position: absolute;
    top: 50%;
    left: 0;
    width: 1rem;
    height: 1px;
    background: var(--color-faint);
    opacity: 0.9;
    transform: translateY(-50%);
    transition:
      width 0.1s ease-out,
      opacity 0.1s ease-out;
  }

  .toc-link::after {
    content: attr(data-text);
    position: absolute;
    top: 0;
    left: 1.35rem;
    max-width: calc(100% - 1.35rem);
    overflow: hidden;
    color: var(--color-ink);
    font-size: 0.8rem;
    line-height: 1.125rem;
    white-space: nowrap;
    text-overflow: ellipsis;
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.2s ease-out;
  }

  :global(.dark) .toc-link::after {
    color: var(--color-ink-dark);
  }

  .toc-link:hover::after,
  .toc-link:focus-visible::after {
    opacity: 1;
  }

  .toc-link:hover::before,
  .toc-link.active::before {
    width: 0.55rem;
    opacity: 1;
    background: var(--color-accent);
  }

  :global(.dark) .toc-link:hover::before,
  :global(.dark) .toc-link.active::before {
    background: var(--color-accent-dark);
  }

  .toc-link.active {
    color: inherit;
  }

  @media (prefers-reduced-motion: reduce) {
    .toc-link,
    .toc-link::before,
    .toc-link::after {
      transition: none;
    }
  }
</style>

<script>
  const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)')

  function scrollToTarget(element) {
    const behavior = reducedMotion.matches ? 'auto' : 'smooth'
    const result = /** @type {unknown} */ (
      element.scrollIntoView({ behavior, block: 'start' })
    )
    if (result instanceof Promise) return result

    return new Promise((resolve) => {
      let timeoutId = 0
      const finish = () => {
        window.clearTimeout(timeoutId)
        window.removeEventListener('scrollend', finish)
        window.removeEventListener('scroll', onScroll)
        resolve()
      }
      const onScroll = () => {
        window.clearTimeout(timeoutId)
        timeoutId = window.setTimeout(finish, 100)
      }
      window.addEventListener('scrollend', finish, { once: true })
      window.addEventListener('scroll', onScroll, { passive: true })
      timeoutId = window.setTimeout(finish, 100)
    })
  }

  function bindToc(toc) {
    if (toc.dataset.bound) return
    toc.dataset.bound = 'true'

    const links = Array.from(toc.querySelectorAll('.toc-link')).filter(
      (link) => !link.classList.contains('toc-title'),
    )
    const headings = links.flatMap((link) => {
      const id = decodeURIComponent((link.getAttribute('href') ?? '').slice(1))
      const heading = id ? document.getElementById(id) : null
      return heading ? [{ id, heading, link }] : []
    })

    function markActive() {
      let active = headings[0]
      for (const item of headings) {
        if (item.heading.getBoundingClientRect().top <= 120) active = item
      }
      for (const item of headings) {
        item.link.classList.toggle('active', item === active)
      }
    }

    let ticking = false
    const onScroll = () => {
      if (!toc.isConnected) {
        window.removeEventListener('scroll', onScroll)
        return
      }
      if (ticking) return
      ticking = true
      requestAnimationFrame(() => {
        markActive()
        ticking = false
      })
    }

    window.addEventListener('scroll', onScroll, { passive: true })
    markActive()

    let scrollId = 0
    toc.addEventListener('click', async (event) => {
      if (!(event.target instanceof Element)) return
      const link = event.target.closest('a.toc-link')
      if (!link) return
      const href = link.getAttribute('href') ?? ''
      if (!href.startsWith('#')) return
      const id = decodeURIComponent(href.slice(1))
      const target = id ? document.getElementById(id) : null
      if (!target) return

      event.preventDefault()
      const current = ++scrollId
      if (!target.hasAttribute('tabindex'))
        target.setAttribute('tabindex', '-1')
      history.pushState(null, '', href)
      await scrollToTarget(target)
      if (current !== scrollId) return
      target.focus({ preventScroll: true })
    })
  }

  function initToc() {
    const toc = document.querySelector('.toc-nav')
    if (toc) bindToc(toc)
  }

  initToc()
  document.addEventListener('astro:page-load', initToc)
</script>
