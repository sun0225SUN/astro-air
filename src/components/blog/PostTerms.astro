---
import { getRelativeLocaleUrl } from 'astro:i18n'
import { localeFromParam, taxonomySlug } from '../../lib/content'

interface Props {
  category?: string
  tags?: string[]
}

const { category, tags = [] } = Astro.props
const lang = localeFromParam(Astro.currentLocale)
---

{(category || tags.length > 0) && (
  <div class='mt-1 flex flex-wrap items-baseline gap-x-3 gap-y-1'>
    {category && (
      <a
        class='no-underline'
        href={getRelativeLocaleUrl(
          lang,
          `blog/category/${taxonomySlug(category)}`,
        )}
      >
        {category}
      </a>
    )}
    {tags.length > 0 && (
      <ul
        class='m-0 flex list-none flex-wrap items-baseline gap-x-3 gap-y-1 p-0'
        role='list'
      >
        {tags.map((tag) => (
          <li>
            <a
              class='no-underline'
              href={getRelativeLocaleUrl(lang, `blog/tag/${taxonomySlug(tag)}`)}
            >
              {tag}
            </a>
          </li>
        ))}
      </ul>
    )}
  </div>
)}
