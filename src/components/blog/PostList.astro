---
import { useTranslations } from '../../i18n'
import { type BlogPost, getBlogPosts, localeFromParam } from '../../lib/content'
import PostRow from './PostRow.astro'

interface Props {
  posts?: BlogPost[]
  variant?: 'latest' | 'archive' | 'dated'
  limit?: number
}

const lang = localeFromParam(Astro.currentLocale)
const t = useTranslations(lang)
const variant = Astro.props.variant ?? 'dated'
const source = Astro.props.posts ?? (await getBlogPosts(lang))
const posts = Astro.props.limit ? source.slice(0, Astro.props.limit) : source
const grouped = variant === 'archive'

const groups: { year: number; posts: BlogPost[] }[] = []
if (grouped) {
  for (const post of posts) {
    const year = post.data.pubDate.getUTCFullYear()
    const last = groups.at(-1)
    if (!last || last.year !== year) groups.push({ year, posts: [post] })
    else last.posts.push(post)
  }
}
---

{posts.length === 0 ? (
  <p class='text-muted dark:text-muted-dark py-2'>{t('home.empty')}</p>
) : grouped ? (
  groups.map((group) => (
    <div class='year-group my-8'>
      <h2 class='my-4 text-2xl font-bold'>{group.year}</h2>
      {group.posts.map((post) => (
        <PostRow post={post} lang={lang} dateFormat='MM-DD' dateWidth='w-20' />
      ))}
    </div>
  ))
) : (
  posts.map((post) => (
    <PostRow post={post} lang={lang} dateFormat='YYYY-MM-DD' dateWidth='w-32' />
  ))
)}
