---
import { getRelativeLocaleUrl } from 'astro:i18n'
import { useTranslations } from '../../i18n'
import {
  type BlogPost,
  entrySlug,
  getBlogPosts,
  localeFromParam,
} from '../../lib/content'
import FormattedDate from './FormattedDate.astro'
import PostTerms from './PostTerms.astro'

interface Props {
  posts?: BlogPost[]
}

const lang = localeFromParam(Astro.currentLocale)
const t = useTranslations(lang)
const posts = Astro.props.posts ?? (await getBlogPosts(lang))
---

{posts.length === 0 ? (
  <p>{t('home.empty')}</p>
) : (
  <ul class='post-list' role='list'>
    {posts.map((post) => (
      <li>
        <a href={getRelativeLocaleUrl(lang, `blog/${entrySlug(post.id)}`)}>
          {post.data.title}
        </a>
        <p>{post.data.description}</p>
        <p class='meta'>
          <FormattedDate date={post.data.pubDate} />
        </p>
        <PostTerms category={post.data.category} tags={post.data.tags} />
      </li>
    ))}
  </ul>
)}
