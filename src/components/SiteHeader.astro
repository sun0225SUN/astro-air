---
import { getRelativeLocaleUrl } from 'astro:i18n'
import { SITE_TITLE } from '../consts'
import { useTranslations } from '../i18n/ui'
import { localeFromParam } from '../lib/content'
import LanguageNav from './LanguageNav.astro'
import PrimaryNav from './PrimaryNav.astro'
import ThemeToggle from './ThemeToggle.astro'

const lang = localeFromParam(Astro.currentLocale)
const t = useTranslations(lang)
---

<a class="skip-link visually-hidden" href="#content">{t('skip')}</a>
<header class="site-header">
  <a class="brand" href={getRelativeLocaleUrl(lang)}>{SITE_TITLE}</a>
  <PrimaryNav />
  <LanguageNav />
  <ThemeToggle />
</header>
