---
import { SITE_TITLE } from '../consts'
import { getCustomPages } from '../lib/content'

const pages = await getCustomPages()
const current = Astro.url.pathname.replace(/\/$/, '') || '/'

function currentPage(href: string) {
  const path = href.replace(/\/$/, '') || '/'
  return path === current ? 'page' : undefined
}

const links = [
  { href: '/', label: 'Home' },
  { href: '/blog', label: 'Blog' },
  ...pages.map((page) => ({ href: `/${page.id}`, label: page.data.title })),
]
---

<a class="skip-link visually-hidden" href="#content">Skip to content</a>
<header class="site-header">
  <a class="brand" href="/">{SITE_TITLE}</a>
  <nav aria-label="Primary">
    <ul>
      {links.map((link) => (
        <li>
          <a href={link.href} aria-current={currentPage(link.href)}>
            {link.label}
          </a>
        </li>
      ))}
    </ul>
  </nav>
</header>
