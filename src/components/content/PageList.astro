---
import { getRelativeLocaleUrl } from 'astro:i18n'
import { entrySlug, getCustomPages, localeFromParam } from '../../lib/content'

const lang = localeFromParam(Astro.currentLocale)
const pages = await getCustomPages(lang)
---

<ul class="m-0 list-none p-0" role="list">
  {pages.map((page) => (
    <li class='border-b border-line py-4'>
      <a
        class='text-xl no-underline'
        href={getRelativeLocaleUrl(lang, entrySlug(page.id))}
      >
        {page.data.title}
      </a>
      <p class='text-muted'>{page.data.description}</p>
    </li>
  ))}
</ul>
