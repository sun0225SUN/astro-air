---
import { getRelativeLocaleUrl } from 'astro:i18n'
import { ClientRouter } from 'astro:transitions'
import ImageViewer from '../components/content/ImageViewer.astro'
import LocaleAlternates from '../components/site/LocaleAlternates.astro'
import PrimaryNav from '../components/site/PrimaryNav.astro'
import SiteFooter from '../components/site/SiteFooter.astro'
import SiteHeader from '../components/site/SiteHeader.astro'
import Umami from '../components/site/Umami.astro'
import { config } from '../config'
import { contentPath, localeFromParam } from '../lib/content'
import '../styles/global.css'

interface Props {
  title: string
  description: string
}

const { title, description } = Astro.props
const lang = localeFromParam(Astro.currentLocale)
const pageTitle = title === config.title ? title : `${config.title} - ${title}`
const publicPath = getRelativeLocaleUrl(
  lang,
  contentPath(Astro.url.pathname, lang),
)
const canonical = Astro.site ? new URL(publicPath, Astro.site) : undefined
---

<!doctype html>
<html
  lang={lang}
  class:list={[
    'bg-page dark:bg-page-dark',
    config.handwriting && 'handwriting',
  ]}
>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    {!config.handwriting && (
      <link
        rel='preload'
        href='/fonts/Snell-Black-SF.woff2'
        as='font'
        type='font/woff2'
        crossorigin
      />
    )}
    <script is:inline>
      const setTheme = () => {
        let theme = 'light'
        try {
          theme =
            localStorage.getItem('theme') ??
            (matchMedia('(prefers-color-scheme: dark)').matches
              ? 'dark'
              : 'light')
        } catch {
          theme = matchMedia('(prefers-color-scheme: dark)').matches
            ? 'dark'
            : 'light'
        }
        document.documentElement.classList.toggle('dark', theme === 'dark')
      }
      setTheme()
      document.addEventListener('astro:before-swap', (event) => {
        const root = event.newDocument?.documentElement
        if (!root) return
        let theme = 'light'
        try {
          theme =
            localStorage.getItem('theme') ??
            (matchMedia('(prefers-color-scheme: dark)').matches
              ? 'dark'
              : 'light')
        } catch {
          theme = matchMedia('(prefers-color-scheme: dark)').matches
            ? 'dark'
            : 'light'
        }
        root.classList.toggle('dark', theme === 'dark')
      })
    </script>
    <ClientRouter fallback="none" />
    <link
      rel="alternate"
      type="application/rss+xml"
      title={config.title}
      href={new URL('rss.xml', Astro.site)}
    />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    {canonical && <link rel='canonical' href={canonical} />}
    <title>{pageTitle}</title>
    <LocaleAlternates />
    <Umami />
  </head>
  <body
    class="flex w-full flex-col items-center bg-transparent px-6 text-ink md:px-0 dark:text-ink-dark"
  >
    <div
      class="pointer-events-none fixed inset-0 z-1 size-full bg-[url('/noise.png')] bg-size-[128px_128px] bg-repeat opacity-6"
    ></div>
    <div class="relative z-2 flex w-full max-w-3xl min-w-0 flex-col">
      <main id="content" tabindex="-1" class="min-w-0">
        <SiteHeader />
        <PrimaryNav />
        <slot />
      </main>
      <SiteFooter />
    </div>
    <ImageViewer />
  </body>
</html>
