---
import { getAbsoluteLocaleUrl } from 'astro:i18n'
import SiteFooter from '../components/SiteFooter.astro'
import SiteHeader from '../components/SiteHeader.astro'
import { SITE_TITLE } from '../consts'
import { defaultLang, locales } from '../i18n/ui'
import { contentPath, hasLocalePath, localeFromParam } from '../lib/content'
import '../styles/a11y.css'
import '../styles/global.css'

interface Props {
  title: string
  description: string
}

const { title, description } = Astro.props
const lang = localeFromParam(Astro.currentLocale)
const path = contentPath(Astro.url.pathname, lang)
const pageTitle = title === SITE_TITLE ? title : `${title} | ${SITE_TITLE}`
const canonical = Astro.site
  ? new URL(Astro.url.pathname, Astro.site)
  : undefined
const alternates = []
for (const locale of locales) {
  if (await hasLocalePath(locale, path)) {
    alternates.push({ locale, href: getAbsoluteLocaleUrl(locale, path) })
  }
}
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="light dark" />
    <script is:inline>
      try {
        const stored = localStorage.getItem('color-scheme')
        if (stored === 'light' || stored === 'dark') {
          document.querySelector('meta[name="color-scheme"]').content = stored
        }
      } catch {
        // Follow the system scheme when storage is blocked.
      }
    </script>
    <link
      rel="alternate"
      type="application/rss+xml"
      title={SITE_TITLE}
      href={new URL('rss.xml', Astro.site)}
    />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    {canonical && <link rel='canonical' href={canonical} />}
    {alternates.map((item) => (
      <link rel='alternate' hreflang={item.locale} href={item.href} />
    ))}
    {(await hasLocalePath(defaultLang, path)) && (
      <link
        rel='alternate'
        hreflang='x-default'
        href={getAbsoluteLocaleUrl(defaultLang, path)}
      />
    )}
    <title>{pageTitle}</title>
  </head>
  <body>
    <SiteHeader />
    <div class="page">
      <slot />
    </div>
    <SiteFooter />
  </body>
</html>
