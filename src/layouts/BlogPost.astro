---
import type { CollectionEntry } from 'astro:content'
import { getRelativeLocaleUrl } from 'astro:i18n'
import type { MarkdownHeading } from 'astro'
import dayjs from 'dayjs'
import utc from 'dayjs/plugin/utc'
import FormattedDate from '../components/blog/FormattedDate.astro'
import PostTerms from '../components/blog/PostTerms.astro'
import TableOfContents from '../components/blog/TableOfContents.astro'
import Prose from '../components/content/Prose.astro'
import { useTranslations } from '../i18n'
import { localeFromParam, taxonomySlug } from '../lib/content'
import Layout from './Layout.astro'
import 'dayjs/locale/ja'
import 'dayjs/locale/ko'
import 'dayjs/locale/zh-cn'

dayjs.extend(utc)

type Props = CollectionEntry<'blog'>['data'] & {
  slug: string
  headings?: MarkdownHeading[]
  lastModified?: string
  readingMinutes?: number
}

const {
  title,
  description,
  pubDate,
  updatedDate,
  category,
  tags,
  slug,
  headings = [],
  lastModified,
  readingMinutes,
} = Astro.props
const lang = localeFromParam(Astro.currentLocale)
const t = useTranslations(lang)
const modified = lastModified ? dayjs(lastModified) : undefined
const modifiedLabel = modified?.isValid()
  ? modified.utc().format('YYYY-MM-DD HH:mm')
  : undefined
---

<Layout title={title} description={description}>
  <article class="prose w-full max-w-3xl overflow-hidden dark:prose-invert">
    <div class="flex flex-col gap-2">
      <h2 class="my-0! text-3xl font-semibold">
        <span
          transition:name={`post-${lang}-${slug}`}
          data-disable-theme-toggle-transition
        >
          {title}
        </span>
      </h2>
      <div
        class="not-prose my-3 flex flex-wrap items-center gap-x-2 text-sm text-gray-500 dark:text-white/70"
      >
        {category && (
            <a
              href={getRelativeLocaleUrl(
                lang,
                `blog/category/${taxonomySlug(category)}`,
              )}
              class="text-accent no-underline hover:text-accent-hover"
            >
              {category}
            </a>
          )}
        {category && <span aria-hidden='true'>·</span>}
        <span
          class="vt-time"
          transition:name={`time-${lang}-${slug}`}
          data-disable-theme-toggle-transition
        >
          <FormattedDate date={pubDate} />
        </span>
        {readingMinutes && (
            <span>· {t('post.readingTime', { minutes: readingMinutes })}</span>
          )}
      </div>
      {updatedDate && (
        <p class='my-0 text-sm text-gray-500 dark:text-white/70'>
          {t('post.updated')} <FormattedDate date={updatedDate} />
        </p>
      )}
      {modifiedLabel && lastModified && (
        <p class='my-0 text-sm text-gray-500 dark:text-white/70'>
          {t('post.lastModified')}{' '}
          <time datetime={lastModified}>{modifiedLabel}</time>
        </p>
      )}
    </div>
    <Prose>
      <div id="post-content">
        <slot />
      </div>
    </Prose>
    <PostTerms tags={tags} />
  </article>
  <TableOfContents headings={headings} />
</Layout>
