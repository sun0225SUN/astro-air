---
import type { CollectionEntry } from 'astro:content'
import dayjs from 'dayjs'
import utc from 'dayjs/plugin/utc'
import FormattedDate from '../components/blog/FormattedDate.astro'
import PostTerms from '../components/blog/PostTerms.astro'
import PageHeading from '../components/content/PageHeading.astro'
import Prose from '../components/content/Prose.astro'
import { useTranslations } from '../i18n'
import { localeFromParam } from '../lib/content'
import Layout from './Layout.astro'
import 'dayjs/locale/ja'
import 'dayjs/locale/ko'
import 'dayjs/locale/zh-cn'

dayjs.extend(utc)

type Props = CollectionEntry<'blog'>['data'] & {
  lastModified?: string
  readingMinutes?: number
}

const {
  title,
  description,
  pubDate,
  updatedDate,
  category,
  tags,
  lastModified,
  readingMinutes,
} = Astro.props
const lang = localeFromParam(Astro.currentLocale)
const t = useTranslations(lang)
const modified = lastModified ? dayjs(lastModified) : undefined
const modifiedLabel = modified?.isValid()
  ? modified
      .utc()
      .locale(lang === 'zh' ? 'zh-cn' : lang)
      .format('HH:mm:ss DD MMMM YYYY UTC')
  : undefined
---

<Layout title={title} description={description}>
  <article>
    <header>
      <p class="text-muted">
        <FormattedDate date={pubDate} />
        {readingMinutes && (
          <>
            {' · '}
            {t('post.readingTime', { minutes: readingMinutes })}
          </>
        )}
      </p>
      {updatedDate && (
        <p class='text-muted'>
          {t('post.updated')} <FormattedDate date={updatedDate} />
        </p>
      )}
      {modifiedLabel && lastModified && (
        <p class='text-muted'>
          {t('post.lastModified')}{' '}
          <time datetime={lastModified}>{modifiedLabel}</time>
        </p>
      )}
      <PageHeading>{title}</PageHeading>
      <p class="text-muted">{description}</p>
      <PostTerms category={category} tags={tags} />
    </header>
    <Prose>
      <slot />
    </Prose>
  </article>
</Layout>
