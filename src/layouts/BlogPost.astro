---
import type { CollectionEntry } from 'astro:content'
import dayjs from 'dayjs'
import utc from 'dayjs/plugin/utc'
import FormattedDate from '../components/FormattedDate.astro'
import { useTranslations } from '../i18n/ui'
import { localeFromParam } from '../lib/content'
import Layout from './Layout.astro'
import 'dayjs/locale/ja'
import 'dayjs/locale/ko'
import 'dayjs/locale/zh-cn'

dayjs.extend(utc)

type Props = CollectionEntry<'blog'>['data'] & {
  lastModified?: string
  readingMinutes?: number
}

const {
  title,
  description,
  pubDate,
  updatedDate,
  lastModified,
  readingMinutes,
} = Astro.props
const lang = localeFromParam(Astro.currentLocale)
const t = useTranslations(lang)
const modified = lastModified ? dayjs(lastModified) : undefined
const modifiedLabel = modified?.isValid()
  ? modified
      .utc()
      .locale(lang === 'zh' ? 'zh-cn' : lang)
      .format('HH:mm:ss DD MMMM YYYY UTC')
  : undefined
---

<Layout title={title} description={description}>
  <article class="prose">
    <header>
      <p class="meta">
        <FormattedDate date={pubDate} />
        {readingMinutes && (
          <>
            {' · '}
            {t('post.readingTime').replace('{minutes}', String(readingMinutes))}
          </>
        )}
      </p>
      {updatedDate && (
        <p class='meta'>
          {t('post.updated')} <FormattedDate date={updatedDate} />
        </p>
      )}
      {modifiedLabel && lastModified && (
        <p class='meta'>
          {t('post.lastModified')}{' '}
          <time datetime={lastModified}>{modifiedLabel}</time>
        </p>
      )}
      <h1 id="content" tabindex="-1">{title}</h1>
      <p class="lede">{description}</p>
    </header>
    <slot />
  </article>
</Layout>
